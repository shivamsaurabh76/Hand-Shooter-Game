# Optional: Custom STUN/TURN servers for production WebRTC
# (Leave blank to use the free Google STUN servers)
WEBRTC_ICE_SERVERS=

# Optional: Streamlit Cloud secrets can be placed here
# and referenced in code via st.secrets["KEY"]

# Optional: Analytics (e.g. PostHog, Plausible)
# ANALYTICS_KEY=
