# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────
# Add this file to .streamlit/ folder for Streamlit Cloud secrets.
# This file is already in .gitignore — never commit actual secrets!
# ─────────────────────────────────────────────────────────────────────

# Example (uncomment if you add custom TURN servers):
# [webrtc]
# turn_url = "turn:your-turn-server.example.com:3478"
# turn_username = "username"
# turn_credential = "password"
